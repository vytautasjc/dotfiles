alias nix-install="nix-env -i"
alias nix-update="nix-env -u '*'"
alias cdx="codex"
alias cdxp="codex --profile"
alias cld="claude"
alias cldp="claude --model opus --effort high"
alias cldd="claude --model sonnet --effort medium"
alias nix-install="nix profile add"
alias nix-update="nix profile upgrade --all"
alias dir-size="du -h --threshold=1G . | sort -hr"
